{
  "openapi": "3.1.0",
  "info": {
    "title": "MiBici: demanda de retiros por estación y hora",
    "description": "\nPredice cuántas bicicletas se **retirarán** de una estación de MiBici (Guadalajara) en una hora\ndada, para que el operador pase de un rebalanceo reactivo a uno preventivo.\n\n* Horizonte: **1 hora** (el modelo usa la demanda de la hora anterior).\n* Modelo: `HistGradientBoostingRegressor` con pérdida Poisson dentro de un `Pipeline` de\n  scikit-learn (imputación + escalado, `TargetEncoder` de la estación y PCA del perfil horario),\n  registrado en MLflow como `mibici-demanda-estacion-hora` con alias `@champion`.\n* Las variables de calendario las calcula el servicio a partir de `fecha_hora`.\n\nProyecto TC5044 Operaciones de aprendizaje automático (Tec de Monterrey), Equipo 15.\n",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "operación"
        ],
        "summary": "Health",
        "description": "200 con el modelo cargado; 503 si la carga falló (lo usa el HEALTHCHECK).",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Salud"
                }
              }
            }
          },
          "503": {
            "description": "El modelo no está cargado."
          }
        }
      }
    },
    "/model-info": {
      "get": {
        "tags": [
          "modelo"
        ],
        "summary": "Model Info",
        "description": "Ficha del modelo desplegado: URI del Registry, versión, métricas y SHA-256.",
        "operationId": "model_info_model_info_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InfoModelo"
                }
              }
            }
          },
          "503": {
            "description": "El modelo no está cargado."
          }
        }
      }
    },
    "/predict": {
      "post": {
        "tags": [
          "predicción"
        ],
        "summary": "Predict",
        "description": "Predice la demanda de retiros para cada registro (estación, hora, rezagos).",
        "operationId": "predict_predict_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SolicitudPrediccion"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaPrediccion"
                }
              }
            }
          },
          "503": {
            "description": "El modelo no está cargado."
          },
          "422": {
            "description": "Entrada inválida (por campo)."
          }
        }
      }
    }
  },
